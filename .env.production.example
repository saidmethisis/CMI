# ── БОЕВОЙ САЙТ ──────────────────────────────────────────────────────────────
# Скопируйте в .env.production на сервере и заполните. В git не попадает.
#   cp .env.production.example .env.production && nano .env.production
#
# ВАЖНО: значения с пробелами, скобками, кавычками или $ БЕРИТЕ В КАВЫЧКИ.
# Файл читается не только Docker Compose, но и через `.` в scripts/backup-db.sh,
# то есть разбирается как обычный shell: незакавыченное «ООО «Ромашка» (Ташкент)»
# уронит бэкап, а вместе с ним и деплой. Комментарии — на отдельной строке.

APP_ENV=production

# nginx проксирует боевой домен сюда
WEB_PORT=3000

# Без слеша на конце
SITE_URL=https://asosiyaktiv.uz

# ОБЯЗАТЕЛЬНО своё: openssl rand -hex 32
AUTH_SECRET=

# ── База (контейнер поднимается рядом, наружу не торчит) ─────────────────────
POSTGRES_USER=aktiv
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=aktiv_prod

# ── Первый супер-админ (создаётся только на пустой базе) ─────────────────────
SUPERADMIN_EMAIL=admin@asosiyaktiv.uz
# Длинный случайный, не из README
SUPERADMIN_PASSWORD=

# ── reCAPTCHA v2: боевые ключи именно для ЭТОГО домена ───────────────────────
# https://www.google.com/recaptcha/admin — домен asosiyaktiv.uz
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Почта (сброс пароля, подтверждение адреса) ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Asosiy Aktiv <noreply@asosiyaktiv.uz>"

# ── AI-генерация PR-материалов (необязательно) ───────────────────────────────
OPENAI_API_KEY=

# ── Реквизиты для правовых страниц (/privacy, /terms, /legal) ────────────────
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_ORG_FOUNDER=
NEXT_PUBLIC_ORG_EDITOR=
NEXT_PUBLIC_ORG_EMAIL=
NEXT_PUBLIC_ORG_PHONE=
NEXT_PUBLIC_ORG_ADDRESS=
NEXT_PUBLIC_ORG_SMI_CERT=
NEXT_PUBLIC_ORG_PD_REGISTRY=
NEXT_PUBLIC_ORG_AGE=18+

# ── SEO и аналитика ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_YM_ID=
