# ── БОЕВОЙ САЙТ ──────────────────────────────────────────────────────────────
# Скопируйте в .env.production на сервере и заполните. В git не попадает.
#   cp .env.production.example .env.production && nano .env.production
#
# ВАЖНО: значения с пробелами, скобками, кавычками или $ БЕРИТЕ В КАВЫЧКИ.
# Файл читается не только Docker Compose, но и через `.` в scripts/backup-db.sh,
# то есть разбирается как обычный shell: незакавыченное «ООО «Ромашка» (Ташкент)»
# уронит бэкап, а вместе с ним и деплой. Комментарии — на отдельной строке.

APP_ENV=production

# nginx проксирует боевой домен сюда
WEB_PORT=3000

# Без слеша на конце
SITE_URL=https://asosiy.net

# ОБЯЗАТЕЛЬНО своё: openssl rand -hex 32
AUTH_SECRET=

# ── База (контейнер поднимается рядом, наружу не торчит) ─────────────────────
POSTGRES_USER=aktiv
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=aktiv_prod

# ── Первый супер-админ (создаётся только на пустой базе) ─────────────────────
SUPERADMIN_EMAIL=admin@asosiy.net
# Длинный случайный, не из README
SUPERADMIN_PASSWORD=

# ── reCAPTCHA v2: боевые ключи именно для ЭТОГО домена ───────────────────────
# https://www.google.com/recaptcha/admin — домен asosiy.net
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Почта (сброс пароля, подтверждение адреса) ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Asosiy Aktiv <noreply@asosiy.net>"

# ── AI-генерация PR-материалов (необязательно) ───────────────────────────────
OPENAI_API_KEY=

# ── Реквизиты для правовых страниц (/privacy, /terms, /legal) ────────────────
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_ORG_FOUNDER=
NEXT_PUBLIC_ORG_EDITOR=
NEXT_PUBLIC_ORG_EMAIL=
NEXT_PUBLIC_ORG_PHONE=
NEXT_PUBLIC_ORG_ADDRESS=
NEXT_PUBLIC_ORG_SMI_CERT=
NEXT_PUBLIC_ORG_PD_REGISTRY=
NEXT_PUBLIC_ORG_AGE=18+

# ── SEO и аналитика ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_YM_ID=

# ── Биржевые котировки (Республиканская фондовая биржа, uzse.uz) ─────────────
# Платный API parse.bot, авторизация заголовком X-API-Key, ~2 кредита за вызов.
# Сервер кэширует ответ на 15 минут — один запрос на весь сайт, не на читателя.
# Без ключа блок котировок просто не отображается (выдуманных цен не будет).
PARSE_API_KEY=

# ── Мгновенная индексация в Google (Indexing API) ────────────────────────────
# Google Cloud → включить «Indexing API» → сервисный аккаунт → ключ JSON.
# Затем в Search Console добавьте client_email из этого JSON ВЛАДЕЛЬЦЕМ домена,
# иначе API отвечает 403. Весь JSON — одной строкой в кавычках.
# Пока переменная пуста, сайт работает как прежде, просто без мгновенного пинга.
GOOGLE_INDEXING_CREDENTIALS=

# ── Рекламные сети ───────────────────────────────────────────────────────────
# Обе выключены, пока не заданы идентификаторы: чужой скрипт — самая тяжёлая
# вещь на странице, и висеть «на всякий случай» он не должен.
#
# Google AdSense: аккаунт → подтвердить домен → взять client вида ca-pub-…,
# создать рекламные блоки и подставить их номера. Плюс строка в ADS_TXT выше.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDE=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
#
# Рекламная сеть Яндекса: площадка в кабинете → блоки R-A-…
# NEXT_PUBLIC_YANDEX_RTB_ENABLED=1 подключает сам скрипт сети.
NEXT_PUBLIC_YANDEX_RTB_ENABLED=
NEXT_PUBLIC_YANDEX_RTB_TOP=
NEXT_PUBLIC_YANDEX_RTB_SIDE=
NEXT_PUBLIC_YANDEX_RTB_INLINE=

# Мгновенное уведомление Яндекса и Bing о новых материалах (IndexNow).
# 8–128 знаков латиницы, цифр и дефиса. Ключ не секрет — он лишь подтверждает,
# что уведомление пришло от владельца сайта; отдаётся по /indexnow-key.txt.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=

# Реквизиты оператора персональных данных для правовых страниц.
# Незаполненные строки на страницах не показываются — прочерков не будет.
NEXT_PUBLIC_ORG_FOUNDER=
NEXT_PUBLIC_ORG_TAX_ID=
NEXT_PUBLIC_ORG_ADDRESS=
NEXT_PUBLIC_ORG_EMAIL=
NEXT_PUBLIC_ORG_PHONE=
NEXT_PUBLIC_ORG_EDITOR=
NEXT_PUBLIC_ORG_PD_REGISTRY=
