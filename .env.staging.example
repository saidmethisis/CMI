# ── СТЕЙДЖИНГ (тестовая копия сайта) ─────────────────────────────────────────
# Скопируйте в .env.staging на сервере и заполните.
#
# Ключевое: ВСЁ должно отличаться от продакшена — порт, база, домен, секреты.
# Иначе стейджинг полезет в боевые данные, и смысл разделения пропадёт.
#
# ВАЖНО: значения с пробелами, скобками, кавычками или $ БЕРИТЕ В КАВЫЧКИ.
# Этот файл не только читается Docker Compose, но и подключается через `.` в
# scripts/backup-db.sh — то есть разбирается как обычный shell. Строка вида
#   NEXT_PUBLIC_ORG_NAME="Asosiy Aktiv (staging)"
# роняет bash с «syntax error near unexpected token `('», из-за чего падает
# бэкап, а вместе с ним и весь деплой. Правильно: NEXT_PUBLIC_ORG_NAME="Asosiy Aktiv (staging)"
# Комментарии тоже пишите на отдельной строке — так надёжнее для обоих парсеров.

APP_ENV=staging

# Другой порт, чем у прода
WEB_PORT=3100

SITE_URL=https://staging.asosiy.net

# СВОЙ секрет, не такой же как в проде: openssl rand -hex 32
AUTH_SECRET=

# ── База: отдельный контейнер и отдельное имя ────────────────────────────────
POSTGRES_USER=aktiv
# Свой пароль: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=aktiv_staging

# ── Админ стейджинга ─────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@asosiy.net
# Пароль стейджинга, НЕ боевой
SUPERADMIN_PASSWORD=

# ── reCAPTCHA ────────────────────────────────────────────────────────────────
# Официальные ТЕСТОВЫЕ ключи Google: работают на любом домене и всегда проходят.
# Для стейджинга этого достаточно. Боевые ключи сюда не подставляйте — они
# привязаны к домену прода и здесь всё равно не сработают.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ── Почта: на стейджинге обычно НЕ настраивают ───────────────────────────────
# Пусто → письма только пишутся в лог, реальным людям ничего не уходит.
RESEND_API_KEY=
EMAIL_FROM=

OPENAI_API_KEY=

# ── Реквизиты: можно заглушки, страница всё равно тестовая ───────────────────
NEXT_PUBLIC_ORG_NAME="Asosiy Aktiv (staging)"
NEXT_PUBLIC_ORG_AGE=18+

# ── Аналитику на стейджинге НЕ включаем: испортит боевую статистику ──────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_YM_ID=

# ── Биржевые котировки (Республиканская фондовая биржа, uzse.uz) ─────────────
# Платный API parse.bot, авторизация заголовком X-API-Key, ~2 кредита за вызов.
# Сервер кэширует ответ на 15 минут — один запрос на весь сайт, не на читателя.
# Без ключа блок котировок просто не отображается (выдуманных цен не будет).
PARSE_API_KEY=

# ── Мгновенная индексация в Google (Indexing API) ────────────────────────────
# Google Cloud → включить «Indexing API» → сервисный аккаунт → ключ JSON.
# Затем в Search Console добавьте client_email из этого JSON ВЛАДЕЛЬЦЕМ домена,
# иначе API отвечает 403. Весь JSON — одной строкой в кавычках.
# Пока переменная пуста, сайт работает как прежде, просто без мгновенного пинга.
GOOGLE_INDEXING_CREDENTIALS=
