{
  "name": "asosiy-aktiv",
  "version": "1.0.0",
  "private": true,
  "description": "Asosiy Aktiv — Next-Gen News PWA (merged TZ implementation)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f docker-compose.dev.yml -p aktiv-dev up -d",
    "db:down": "docker compose -f docker-compose.dev.yml -p aktiv-dev down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "admin:password": "node --env-file=.env scripts/set-admin-password.mjs",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "deploy:prod": "bash scripts/deploy.sh production"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "15.5.23",
    "openai": "^4.104.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.26",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "sharp": "0.35.3",
    "postcss": "8.5.26",
    "nanoid": "3.3.18"
  }
}
